{
  "name": "buyananswer",
  "version": "0.0.0",
  "private": true,
  "description": "Paid Q&A escrow — your link in bio, but every tip buys a real answer. USDC on Base, Cloudflare stack.",
  "license": "SEE LICENSE IN LICENSE-MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "better-sqlite3", "esbuild", "workerd"]
  }
}
