# Copy to `.dev.vars` (git-ignored) for local development. Never commit real values.
# `.dev.vars` provides secrets/vars to `wrangler dev` locally and overrides wrangler.jsonc `vars`.

# Farcaster hub that validates frame message signatures (POST /v1/validateMessage). REQUIRED for the
# frame to accept any POST — verification is fail-closed, so if this is unset (and no wrangler.jsonc
# default applies) every frame action is rejected. A public hub works for local testing; use a
# private hub or a keyed provider for production reliability.
FRAME_HUB_URL=https://hub.pinata.cloud

# Optional bearer token sent to the hub's validateMessage endpoint (e.g. a Neynar API key). Leave
# empty for keyless public hubs.
FRAME_HUB_AUTH=

# Origin of the deployed web app (deep-links: /ask/:handle, /questions/:id, /:handle board). Prod:
# https://app.buyananswer.com
APP_ORIGIN=http://localhost:5173

# Base URL the branded frame images are served from. Defaults to APP_ORIGIN in dev.
FRAME_IMAGE_BASE=http://localhost:5173

# Cloudflare account that owns the remote D1 (only needed for `--remote` ops, not `--local`).
CLOUDFLARE_ACCOUNT_ID=

# The remote D1 database id from `wrangler d1 create buyananswer-dev` — the SAME database the API +
# indexer use. Local dev / vitest ignore it; wrangler.jsonc's top-level (dev) binding is a
# placeholder; `env.production` carries the real provisioned id.
D1_DATABASE_ID=

# Remote KV namespace id from `wrangler kv namespace create RATELIMIT` (Session 14 / ADR-0032: per-fid
# frame rate-limit counters). `--local` / vitest ignore it; wrangler.jsonc's dev binding is a
# placeholder; `env.production` carries the real provisioned id.
KV_RATELIMIT_ID=

# Optional overrides (otherwise taken from wrangler.jsonc `vars`):
# CHAIN_ID=84532
# ORPHAN_TTL_HOURS=24  # age before an abandoned pending_payment draft is swept (default 24)
