{
  // Cloudflare Worker config for the BuyAnAnswer Farcaster frame — the in-feed ask+pay surface.
  // It renders board/ask frames, validates the Farcaster frame signature server-side, mints the
  // off-chain question row (chain-first, non-money-state only), and returns Base USDC transactions
  // (approve → askQuestion) built by @buyananswer/sdk. NO secrets or account-scoped ids live here:
  // `account_id`, API tokens, and the remote D1 id come from the environment (`.dev.vars`, CI secrets).
  //
  // The D1 binding points at the SAME database as the API + indexer (`buyananswer-dev`) and the SAME
  // shared migrations. `database_id` is a non-secret placeholder — `--local` / vitest-pool-workers key
  // the local SQLite by binding + database_name and ignore it. Set the real remote id per-environment
  // out of band (see .dev.vars.example). (ADR-0021, ADR-0031)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buyananswer-frame",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-04",
  "compatibility_flags": ["nodejs_compat"],
  // Prune abandoned `pending_payment` drafts (approved-then-never-confirmed) once an hour. The sweep is
  // age-gated + guarded to NEVER touch a row the indexer has moved off pending_payment (ADR-0032).
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buyananswer-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      // Shared migrations (generated from packages/shared/src/db/schema.ts). The frame writes ONLY the
      // initial `pending_payment` question row (same non-money-state insert the API's POST /questions
      // does); money-state stays the indexer's alone (ADR-0024).
      "migrations_dir": "../../packages/shared/migrations"
    }
  ],
  // Abuse controls (Session 14, ADR-0032): per-fid rate-limit counters for the frame POSTs. Placeholder
  // id — Miniflare keys the local namespace by binding name; create the real one with
  // `wrangler kv namespace create RATELIMIT`.
  "kv_namespaces": [
    {
      "binding": "RATELIMIT",
      "id": "00000000000000000000000000000001",
      "preview_id": "00000000000000000000000000000001"
    }
  ],
  "vars": {
    // Chain to build transactions for (dev: Base Sepolia). The escrow + USDC addresses and the CAIP-2
    // chainId are read from @buyananswer/shared `escrowDeployments[CHAIN_ID]`, not duplicated here.
    "CHAIN_ID": "84532",
    // Origin of the web app for deep-links the frame can't do in-feed (long question body, answering,
    // the question detail / board). Dev: the local web dev server; prod: app.buyananswer.com.
    "APP_ORIGIN": "http://localhost:5173",
    // Base URL the branded frame PNGs are served from (default: the web app's public dir). Swap to a
    // request-time image renderer when the Workers-runtime rasterizer lands (ADR-0026, ADR-0031).
    "FRAME_IMAGE_BASE": "http://localhost:5173",
    // Farcaster hub used to VALIDATE frame message signatures server-side (fail-closed: if unset or the
    // call fails, every frame POST is rejected). A public hub works for dev; use a private hub / a
    // keyed provider (e.g. Neynar) for production reliability. Overridable via .dev.vars / secret.
    "FRAME_HUB_URL": "https://hub.pinata.cloud",
    // Age (hours) after which an abandoned `pending_payment` draft with no on-chain match is pruned by
    // the hourly sweep. Generous so a slow payer is never pruned mid-flow (Session 14 / ADR-0032).
    "ORPHAN_TTL_HOURS": "24"
  },

  // ───────────────────────────────────────────────────────────────────────────────────────────
  // PRODUCTION (Base mainnet, chain 8453) — `wrangler deploy --env production` (ADR-0038).
  //
  // ⚠ Named environments do NOT inherit `vars`, bindings, or `triggers` — all redeclared below.
  //
  // ⚠ Like the indexer, the frame builds its transactions from `escrowDeployments[8453]`, so the
  //   mainnet escrow address must be recorded before this is deployed.
  //
  // ⚠ FRAME_HUB_URL must be a TRUSTED hub. Frame POSTs are validated against it fail-closed, and
  //   the verified wallet it returns becomes the asker — a hostile hub could attribute a paid
  //   question to the wrong wallet. This is a known, accepted risk (see SECURITY.md). The public
  //   Pinata hub used in dev is NOT appropriate for production. Production uses Neynar (below).
  //
  // SECRETS (names only; `wrangler secret put --env production <NAME>`):
  //   FRAME_HUB_AUTH — the Neynar API key. REQUIRED: unkeyed the hub returns 402 and every ask is
  //                    rejected (the verifier is fail-closed).
  // ───────────────────────────────────────────────────────────────────────────────────────────
  "env": {
    "production": {
      "name": "buyananswer-frame-production",
      "triggers": {
        "crons": ["17 * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "buyananswer-production",
          "database_id": "a5778629-984e-4a9f-8483-77b9edd852e2",
          "migrations_dir": "../../packages/shared/migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "RATELIMIT", "id": "97269f7354e442f495f0284dfa9cb054" }],
      "vars": {
        "CHAIN_ID": "8453",
        "APP_ORIGIN": "https://app.buyananswer.com",
        "FRAME_IMAGE_BASE": "https://buyananswer.com",
        // Neynar's hub (they operate Farcaster/Snapchain since Jan 2026). Verified in Session 19
        // against the live endpoint with this Worker's exact request shape: POST
        // /v1/validateMessage, Content-Type application/octet-stream, raw protobuf bytes, keyed via
        // the `api_key` header (the Worker sends both `api_key` and `Authorization: Bearer`).
        //
        // ⚠ The key is NOT optional. Unkeyed, this endpoint returns **402** (x402 micropayment
        // required), and the verifier fails closed on any non-200 — so a frame without
        // FRAME_HUB_AUTH set rejects EVERY ask rather than degrading. Set it with:
        //   pnpm --filter @buyananswer/frame exec wrangler secret put FRAME_HUB_AUTH --env production
        "FRAME_HUB_URL": "https://hub-api.neynar.com",
        "ORPHAN_TTL_HOURS": "24"
      }
    }
  }
}
