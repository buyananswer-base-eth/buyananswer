# SPDX-License-Identifier: MIT
# Web app environment (Vite). Copy to `.env` for local dev. Only VITE_-prefixed vars reach the client.
# Nothing secret belongs here — the app is a public SPA.

# WalletConnect Cloud project id (optional). When set, the WalletConnect connector is enabled in
# addition to injected + Coinbase Wallet. Get one at https://cloud.walletconnect.com.
# Leave empty for dev/CI — injected wallets (MetaMask, etc.) work without it.
VITE_WALLETCONNECT_PROJECT_ID=

# Where the dev server proxies /api/* — the local API Worker (wrangler dev).
# Defaults to http://127.0.0.1:8787 when unset.
VITE_API_PROXY_TARGET=

# RPC endpoints the app reads chain state through (balances, allowance, simulate). Unset ⇒ viem's
# DEFAULT PUBLIC endpoint for the chain — fine for dev, but on Base mainnet that is the
# load-balanced endpoint whose read-after-write inconsistency caused the Session-18 F1 defect
# (ADR-0037). Production should set at least VITE_BASE_RPC_URL to the same private provider the
# indexer uses (ADR-0038).
#
# ⚠ VITE_-prefixed ⇒ COMPILED INTO THE PUBLIC CLIENT BUNDLE. Use a domain-restricted / publishable
# provider key here. Never reuse the unrestricted key set as the indexer's RPC_URL_BASE secret.
VITE_BASE_RPC_URL=
VITE_BASE_SEPOLIA_RPC_URL=

# --- Server-side (SSR) only — NOT VITE_-prefixed, so never exposed to the client. ---

# Origin the SSR board loader uses to reach the API Worker for the PUBLIC board read (no cookie).
# Dev default: http://127.0.0.1:8787 (matches VITE_API_PROXY_TARGET). In production set this to the
# API Worker's origin (or wire a service binding).
SSR_API_ORIGIN=

# Canonical site origin for absolute OG/canonical URLs on the public board. Production pins
# https://buyananswer.com (ADR-0011). When unset, the SSR falls back to the incoming request origin
# so OG image + canonical URLs resolve locally in dev (e.g. http://localhost:5173).
SITE_ORIGIN=
