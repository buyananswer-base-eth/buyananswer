{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "noEmit": true,
    // React Router v7 typegen writes per-route types under .react-router/types; rootDirs merges that
    // tree so route modules can `import type { Route } from "./+types/<route>"`.
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": [
    "app",
    "test",
    "vite.config.ts",
    "vitest.config.ts",
    "react-router.config.ts",
    ".react-router/types/**/*"
  ]
}
