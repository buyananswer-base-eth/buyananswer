# BuyAnAnswerEscrow — deploy configuration (Session 4).
# Copy to `contracts/.env` (git-ignored) and fill in. NEVER commit real values.
#   cp contracts/.env.example contracts/.env
# Load before running forge:  set -a; source contracts/.env; set +a
#
# The SIGNING KEY is intentionally NOT listed here. Supply it to `forge` at the CLI and keep it
# out of every file (ADR-0012). Preferred: an encrypted keystore account —
#   cast wallet import buyananswer-deployer --interactive   # paste the key ONCE, encrypted at rest
#   forge script ... --account buyananswer-deployer --sender <PUBLIC_ADDRESS>
# Alternatives: --ledger (hardware) or --interactive (paste at runtime). Only fall back to
# `--private-key $PRIVATE_KEY` (env, never a file) if no keystore is available.
# The Base-mainnet deploy uses `--interactive` (ADR-0038): the key is pasted at runtime and is
# never written to disk, env, or shell history.

# --- Network ---
# Base Sepolia RPC (public default shown; a private RPC is fine too).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Base MAINNET RPC. Use ONE consistent private provider across the deploy, the indexer's getLogs,
# and the web app's reads — a load-balanced public endpoint is read-after-write inconsistent and
# caused the Session-18 F1 defect (ADR-0037/ADR-0038). The URL embeds an API key: keep it in the
# git-ignored contracts/.env, NEVER here.
BASE_RPC_URL=https://your-private-base-mainnet-rpc/REPLACE_ME

# --- Contract constructor args ---
# USDC token for the target chain. REQUIRED, no default (per-chain, never hardcoded — ADR-0018).
# Base Sepolia = Circle's testnet USDC:
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base MAINNET = Circle's native USDC (6 dp). Verified in Session 19 three ways: Circle's official
# address list, an on-chain name()/symbol()/decimals() read, and an EIP-55 checksum match.
#   USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Owner + fee recipient. Testnet default (if unset) = the public dev wallet 0xE0f0…cc43 (ADR-0012).
# Mainnet MUST set these to a Safe/hardware wallet — a hot EOA owner can pause() and strand open
# escrow. Mainnet values live in the git-ignored contracts/.env (ADR-0038).
ESCROW_OWNER=0xE0f0275d3Db47d9DcD056766b02fc7606F36cc43
FEE_ADDRESS=0xE0f0275d3Db47d9DcD056766b02fc7606F36cc43

# Fees (basis points) + answer window (seconds). Defaults match FUNCTIONAL_SPEC §4 / ADR-0014/0015.
ANSWER_FEE_BPS=420      # 4.2%  (cap 1000)
CANCEL_FEE_BPS=100      # 1%    (cap 500)
ANSWER_WINDOW=604800    # 7 days (cap 2592000 = 30 days)

# --- Verification ---
# Etherscan v2 unified API key (works for Basescan). Used by `forge ... --verify`.
ETHERSCAN_API_KEY=your_etherscan_v2_api_key
